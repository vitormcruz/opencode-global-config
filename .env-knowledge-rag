# Configuracao do knowledge-rag para este repositorio
# Define as collections a serem indexadas pelo MCP de documentacao
#
# Formato: path1:collection1,path2:collection2,...
# - path: caminho relativo a partir da raiz do projeto
# - collection: nome da collection no knowledge-rag
#
# As collections sao separadas por virgula.
# Exemplo: ./docs:docs,./agents:agents,./skills:skills

# Collections do opencode-config
KNOWLEDGE_RAG_COLLECTIONS="./docs:docs,./agents:agents,./skills:skills,./plan:plan"

