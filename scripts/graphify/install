#!/usr/bin/env bash
# scripts/graphify/install
# Instala o Graphify (graphifyy) via pipx e configura para OpenCode.
# Para configurar VS Code Copilot Chat, use: scripts/graphify/install-vscode
# Idempotente: se ja instalado, reporta OK e sai.
#
# Uso: ./scripts/graphify/install [--yes] [--check-only]

set -euo pipefail

assume_yes=0
check_only=0

while [ $# -gt 0 ]; do
  case "$1" in
    --yes)        assume_yes=1 ;;
    --check-only) check_only=1 ;;
    --help|-h)
      cat <<'EOF'
install

Instala o Graphify (graphifyy) no WSL e configura para OpenCode.
Para VS Code Copilot Chat, use: scripts/graphify/install-vscode

Uso:
  ./scripts/graphify/install [--yes] [--check-only]

Opcoes:
  --yes         Instala sem pedir confirmacao
  --check-only  Apenas verifica status (nao instala)
  --help        Mostra esta ajuda
EOF
      exit 0
      ;;
    *) echo "Opcao desconhecida: $1" >&2; exit 2 ;;
  esac
  shift
done

# --------------------------------------------------------------------------
# Helpers
# --------------------------------------------------------------------------
has_cmd() { command -v "$1" >/dev/null 2>&1; }

confirm_action() {
  local msg="$1"
  if [ "$assume_yes" -eq 1 ]; then return 0; fi
  if ! [ -t 0 ] || ! [ -t 1 ]; then return 0; fi
  printf '%s [y/N] ' "$msg"
  read -r ans || true
  case "$ans" in y|Y|yes|YES) return 0 ;; esac
  return 1
}

# Garante ~/.local/bin no PATH para encontrar graphify apos instalacao
export PATH="$HOME/.local/bin:$PATH"

# --------------------------------------------------------------------------
# Verificar graphify
# --------------------------------------------------------------------------
check_graphify() {
  has_cmd graphify
}

# --------------------------------------------------------------------------
# Instalar graphify via pipx
# --------------------------------------------------------------------------
install_graphify() {
  echo "  -> Instalando graphifyy via pipx..."
  pipx install graphifyy
}

# --------------------------------------------------------------------------
# Configurar para OpenCode
# --------------------------------------------------------------------------
configure_opencode() {
  echo "  -> Configurando para OpenCode..."
  graphify install --platform opencode
}

# --------------------------------------------------------------------------
# Main
# --------------------------------------------------------------------------
echo "[graphify] Mapa de conhecimento para AI coding assistants"

if check_graphify; then
  ver="$(graphify --version 2>/dev/null | head -1 || echo '(versao desconhecida)')"
  echo "  OK       graphify $ver"
  echo ""

  if [ "$check_only" -eq 1 ]; then
    exit 0
  fi
  exit 0
fi

echo "  MISSING  graphify"

if [ "$check_only" -eq 1 ]; then
  exit 1
fi

if ! has_cmd pipx; then
  echo "  MISSING  pipx (necessario para instalar graphifyy)"
  echo "           Execute primeiro: ./scripts/bootstrap_repo/opencode-install-deps"
  exit 1
fi

if confirm_action "  Instalar graphifyy via pipx agora?"; then
  if install_graphify; then
    export PATH="$HOME/.local/bin:$PATH"
    if check_graphify; then
      echo "  INSTALLED graphify"
      echo ""
      configure_opencode
    else
      echo "  MISSING  graphify instalado mas nao encontrado no PATH"
      echo "           Execute: export PATH=\"\$HOME/.local/bin:\$PATH\""
    fi
  else
    echo "  MISSING  graphifyy — falha ao instalar via pipx"
    exit 1
  fi
else
  echo "           Para instalar depois: pipx install graphifyy && graphify install --platform opencode"
fi

echo ""
