{
    "compress": {
        "permission": "allow",
        "mode": "range",
        "maxContextLimit": 130000,
        "minContextLimit": 999999999,
        "nudgeForce": "soft",
        "nudgeFrequency": 10,
        "protectUserMessages": false
    },
    "experimental": {
        "allowSubAgents": true,
        "customPrompts": true
    },
    "autoUpdate": false
}
