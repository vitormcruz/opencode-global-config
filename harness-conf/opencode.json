{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        "@slkiser/opencode-quota"
    ],
    "compaction": {
        "auto": true,
        "prune": true,
        "reserved": 10000
    },
    "agent": {
        "aws-analista": {
            "permission": {
                "skill": {
                    "aws-*": "allow"
                }
            }
        }
    },
    "permission": {
        "skill": {
            "aws-*": "deny"
        }
    }
}
