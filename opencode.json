{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        "@slkiser/opencode-quota"
    ],
    "compaction": {
        "auto": false,
        "prune": true,
        "reserved": 10000
    },
    "mcp": {
        "crawl4ai": {
            "type": "remote",
            "url": "http://localhost:11235/mcp/sse",
            "enabled": true
        },
        "codebase-memory": {
            "type": "local",
            "command": [
                "codebase-memory-mcp"
            ],
            "enabled": true
        },
        "doctree": {
            "type": "local",
            "command": [
                "doctree-run"
            ],
            "enabled": true
        }
    },
    "agent": {
        "aws-analista": {
            "permission": {
                "skill": {
                    "aws-*": "allow"
                }
            }
        }
    },
    "permission": {
        "skill": {
            "aws-*": "deny"
        }
    }
}
